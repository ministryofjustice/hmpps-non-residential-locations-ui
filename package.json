{
  "name": "hmpps-non-residential-locations-ui",
  "version": "0.0.1",
  "description": "HMPPS Non Residential Locations Ui",
  "repository": "git@github.com:ministryofjustice/hmpps-non-residential-locations-ui.git",
  "license": "MIT",
  "scripts": {
    "prepare": "hmpps-precommit-hooks-prepare",
    "watch-ts": "tsc -w",
    "build": "node esbuild/esbuild.config.js --build",
    "start": "node $NODE_OPTIONS dist/server.js | bunyan -o short",
    "start:dev": "concurrently -k -p \"[{name}]\" -n \"ESBuild,Node\" -c \"yellow.bold,cyan.bold\" \"node esbuild/esbuild.config.js --build --watch\" \"node esbuild/esbuild.config.js --dev-server\"",
    "start-feature": " node $NODE_DEBUG_OPTION --env-file=feature.env dist/server.js | bunyan -o short",
    "start-feature:dev": "concurrently -k -p \"[{name}]\" -n \"ESBuild,Node\" -c \"yellow.bold,cyan.bold\" \"node esbuild/esbuild.config.js  --build --watch \" \"node esbuild/esbuild.config.js --dev-test-server\"",
    "lint": "eslint . --cache --max-warnings 0",
    "lint-fix": "eslint . --cache --max-warnings 0 --fix",
    "typecheck": "tsc && tsc -p integration_tests",
    "test": "jest",
    "test:ci": "jest --runInBand",
    "security_audit": "npx audit-ci --config audit-ci.json",
    "int-test": "cypress run --config video=false",
    "int-test-ui": "cypress open --e2e --browser chrome",
    "clean": "rm -rf dist test_results",
    "rebuild": "npm run clean && npm run setup && npm run build",
    "generate-location-api-types": "openapi-typescript https://locations-inside-prison-api-dev.hmpps.service.justice.gov.uk/v3/api-docs > ./server/@types/locationsApi/index.d.ts",
    "setup": "npm ci"
  },
  "engines": {
    "node": "^24",
    "npm": "^12"
  },
  "dependencies": {
    "@aws-sdk/client-sqs": "^3.1146.0",
    "@ministryofjustice/frontend": "11.1.0",
    "@ministryofjustice/hmpps-auth-clients": "^3.0.0",
    "@ministryofjustice/hmpps-monitoring": "^2.1.0",
    "@ministryofjustice/hmpps-rest-client": "^2.2.0",
    "applicationinsights": "^2.9.8",
    "body-parser": "^2.3.0",
    "bunyan": "^1.8.15",
    "bunyan-format": "^0.2.1",
    "compression": "^1.8.2",
    "connect-flash": "^0.1.1",
    "connect-redis": "^10.0.0",
    "cookie-parser": "^1.4.7",
    "csrf-sync": "^4.2.1",
    "express": "4.22.3",
    "express-session": "^1.19.0",
    "govuk-frontend": "^6.5.1",
    "helmet": "^8.3.0",
    "hmpo-form-wizard": "^18.0.0",
    "http-errors": "^2.0.1",
    "jwt-decode": "^4.0.0",
    "lodash": "4.18.1",
    "nocache": "^4.0.0",
    "nunjucks": "^3.2.4",
    "passport": "^0.7.0",
    "passport-oauth2": "^1.8.0",
    "proxy-addr": "2.0.8",
    "redis": "^6.3.0",
    "superagent": "^10.4.1"
  },
  "devDependencies": {
    "@jgoz/esbuild-plugin-typecheck": "^5.0.0",
    "@ministryofjustice/eslint-config-hmpps": "^1.0.3",
    "@ministryofjustice/hmpps-precommit-hooks": "^3.0.2",
    "@tsconfig/node24": "^24.0.5",
    "@types/bunyan": "^1.8.11",
    "@types/bunyan-format": "^0.2.9",
    "@types/compression": "^1.8.1",
    "@types/connect-flash": "0.0.40",
    "@types/cookie-parser": "^1.4.10",
    "@types/express-session": "^1.19.0",
    "@types/http-errors": "^2.0.5",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/lodash": "^4.17.25",
    "@types/node": "^24.19.1",
    "@types/nunjucks": "^3.2.6",
    "@types/passport": "^1.0.17",
    "@types/passport-oauth2": "^1.8.0",
    "@types/superagent": "^8.1.11",
    "@types/supertest": "^7.2.1",
    "audit-ci": "^7.1.0",
    "aws-sdk-client-mock": "^4.1.0",
    "chokidar": "^5.0.0",
    "concurrently": "^10.0.5",
    "cypress": "16.1.1",
    "cypress-multi-reporters": "^2.0.5",
    "cypress-split": "^1.25.0",
    "esbuild": "^0.28.2",
    "esbuild-plugin-clean": "^1.0.1",
    "esbuild-plugin-copy": "^2.1.1",
    "esbuild-plugin-manifest": "^1.0.5",
    "esbuild-sass-plugin": "^3.7.0",
    "fishery": "^2.4.0",
    "jest": "^30.5.2",
    "jest-html-reporter": "^4.4.2",
    "jest-junit": "^17.0.0",
    "jest-mock": "^30.5.2",
    "jsonwebtoken": "^9.0.3",
    "lint-staged": "^17.6.0",
    "mocha-junit-reporter": "^2.2.1",
    "nock": "^14.0.17",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.9.9",
    "prettier-plugin-jinja-template": "^2.2.0",
    "supertest": "^7.3.1",
    "ts-jest": "^29.4.14",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "@jgoz/esbuild-plugin-typecheck": {
      "esbuild": "$esbuild"
    },
    "nunjucks": {
      "chokidar": "$chokidar"
    },
    "@opentelemetry/core": "2.11.0",
    "@opentelemetry/resources": "2.11.0",
    "@opentelemetry/sdk-trace-base": "2.11.0",
    "@opentelemetry/sdk-trace-web": "2.11.0",
    "js-yaml": "5.4.2",
    "form-data": "4.0.6",
    "diff": "9.0.0",
    "qs": "6.16.0",
    "tar": "7.5.22",
    "serialize-javascript": "7.1.2",
    "shell-quote": "1.11.0",
    "tmp": "0.2.7"
  },
  "allowScripts": {
    "cypress@16.1.1": true,
    "@parcel/watcher@2.6.0": true,
    "dtrace-provider@0.8.8": false,
    "fsevents@2.3.3": true,
    "unrs-resolver@1.12.2": true,
    "esbuild@0.28.2": true
  }
}
